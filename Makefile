# Charter developer and CI tasks. Workflows only install tools and call these
# targets, so every CI step runs the same way locally. `make help` lists them.

SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help

BINARY        := charter-iam
MUSL_TARGET   := x86_64-unknown-linux-musl
IMAGE         ?= ghcr.io/firestoned/charter:dev
VERSION_FILE  ?= Cargo.toml
RELEASE_DIR   ?= release
CRD_FILE      := deploy/crd.yaml
LICENSE_HOLDER := Erick Bourgeois, charter

# kind: same pins as mediatore (kind release checksum-verified, node image by digest).
KIND_VERSION      ?= 0.33.0
KIND_NODE_IMAGE   ?= kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KIND_CLUSTER_NAME ?= charter
KIND_BIN_DIR      ?= /usr/local/bin
KIND_DIR          := .kind
KIND_KUBECONFIG   := $(KIND_DIR)/kubeconfig
KIND_IMAGE        := ghcr.io/firestoned/charter:kind
CONTAINER_TOOL    ?= $(shell command -v docker >/dev/null 2>&1 && echo docker || echo podman)

.PHONY: help fmt fmt-check lint test deny audit check crd crd-check license-check \
	sbom dist image set-version set-version-test release-assets release-assets-test \
	kind-install kind-create kind-delete kind-image kind-e2e kind-e2e-ci \
	docs docs-serve docs-clean clean

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-20s %s\n", $$1, $$2}'

# ─── Rust ─────────────────────────────────────────────────────────────────────

fmt: ## Format the code
	cargo fmt

fmt-check: ## Check formatting without writing
	cargo fmt --check

lint: ## Clippy, warnings are errors
	cargo clippy --all-targets --locked -- -D warnings

test: ## Unit tests
	cargo test --locked

deny: ## Licence, advisory and source checks (cargo-deny)
	cargo deny check

audit: ## cargo-audit advisory scan (CI uses the security-scan composite action)
	@command -v cargo-audit >/dev/null 2>&1 || cargo install cargo-audit --locked
	cargo audit

check: fmt-check lint test crd-check license-check ## The pre-commit gate

# ─── Generated files and headers ──────────────────────────────────────────────

crd: ## Regenerate deploy/crd.yaml from src/crd.rs (with its licence header)
	@{ printf '# Copyright (c) 2026 %s\n# SPDX-License-Identifier: Apache-2.0\n#\n# Generated by `make crd` from src/crd.rs. Do not edit by hand.\n' "$(LICENSE_HOLDER)"; \
	   cargo run --locked -q -- crd; } > $(CRD_FILE).tmp && mv $(CRD_FILE).tmp $(CRD_FILE)
	@echo "✓ $(CRD_FILE) regenerated"

crd-check: ## Fail if deploy/crd.yaml is not what src/crd.rs generates
	@cargo run --locked -q -- crd | diff - <(grep -v '^#' $(CRD_FILE)) \
	  || { echo "ERROR: $(CRD_FILE) is stale; run make crd"; exit 1; }
	@echo "✓ $(CRD_FILE) in sync with src/crd.rs"

license-check: ## Every source, script, manifest and workflow carries an SPDX header (same rule as CI)
	@missing=$$(git ls-files -co --exclude-standard \
	    '*.rs' '*.sh' '*.py' '*.yaml' '*.yml' '*.toml' '*.md' '*.css' '*.js' 'Makefile' 'Dockerfile' \
	  | grep -v -e '^LICENSE' -e 'poetry.lock' \
	  | while read -r f; do head -n 10 "$$f" | grep -q 'SPDX-License-Identifier:' || echo "$$f"; done); \
	  if [ -n "$$missing" ]; then echo "Missing SPDX header:"; echo "$$missing" | sed 's/^/  /'; exit 1; fi
	@echo "✓ SPDX headers present"

# ─── Build artefacts ──────────────────────────────────────────────────────────

sbom: ## CycloneDX SBOM of the Rust dependencies (charter-iam.cdx.json)
	@command -v cargo-cyclonedx >/dev/null 2>&1 || cargo install cargo-cyclonedx --locked
	cargo cyclonedx --format json
	@echo "✓ CycloneDX SBOM generated"

dist: ## Static musl binary into dist/ (what the image copies with BINARY_FROM=host)
	cargo build --release --locked --target $(MUSL_TARGET)
	@mkdir -p dist
	cp target/$(MUSL_TARGET)/release/$(BINARY) dist/
	@echo "✓ dist/$(BINARY)"

image: ## Build the controller image (compiled inside the image); IMAGE=... to tag
	$(CONTAINER_TOOL) build -t $(IMAGE) .

set-version: ## Set [package] version in VERSION_FILE to VERSION; fails if the file does not then say so
	@test -n "$(VERSION)" || { echo "set VERSION, e.g. make set-version VERSION=1.2.3"; exit 1; }
	@perl -i -pe 's/^version = ".*"/version = "$(VERSION)"/ if /^\[package\]/ ... /^\[/' $(VERSION_FILE)
	@got=$$(awk -F'"' '/^\[package\]/ { p = 1; next } /^\[/ { p = 0 } p && /^version *=/ { print $$2; exit }' $(VERSION_FILE)); \
	  if [ "$$got" != "$(VERSION)" ]; then echo "$(VERSION_FILE): version is '$$got', expected '$(VERSION)'"; exit 1; fi; \
	  echo "$(VERSION_FILE): version $(VERSION)"

set-version-test: ## Prove set-version changes the package version, and only it, and the crate still resolves
	@tmp=$$(mktemp -d); trap 'rm -rf "$$tmp"' EXIT; \
	  cp Cargo.toml Cargo.lock "$$tmp/" && cp -R src "$$tmp/"; \
	  $(MAKE) --no-print-directory -s set-version VERSION=9.8.7 VERSION_FILE="$$tmp/Cargo.toml" >/dev/null; \
	  changed=$$(diff Cargo.toml "$$tmp/Cargo.toml" | grep -c '^>' || true); \
	  [ "$$changed" = "1" ] || { echo "set-version changed $$changed lines, expected exactly 1"; exit 1; }; \
	  grep -q '^version = "9.8.7"' "$$tmp/Cargo.toml" || { echo "set-version did not set the version"; exit 1; }; \
	  ( cd "$$tmp" && cargo metadata --format-version 1 >/dev/null ) || { echo "the crate does not resolve at a new version"; exit 1; }; \
	  echo "set-version-test: ok"

release-assets: ## Gather RELEASE_DIR for VERSION: binary + SBOMs (staged in dist/), charter-VERSION.yaml pinned to IMAGE_DIGEST, admission and Flux manifests, checksums
	@test -n "$(VERSION)" || { echo "set VERSION"; exit 1; }
	@echo "$(IMAGE_DIGEST)" | grep -Eq '^sha256:[0-9a-f]{64}$$' || { echo "set IMAGE_DIGEST=sha256:<64 hex>"; exit 1; }
	@rm -rf $(RELEASE_DIR) && mkdir -p $(RELEASE_DIR)
	cp dist/$(BINARY) $(RELEASE_DIR)/$(BINARY)-linux-amd64
	@for f in dist/*.json; do [ -e "$$f" ] && cp "$$f" $(RELEASE_DIR)/; done; true
	@{ printf '# Charter %s install bundle: CRD, controller RBAC and Deployment (image pinned by digest).\n' "$(VERSION)"; \
	   cat $(CRD_FILE); echo '---'; cat deploy/rbac.yaml; echo '---'; \
	   sed -E 's#image: ghcr.io/firestoned/charter@sha256:[A-Za-z0-9_]+#image: ghcr.io/firestoned/charter@$(IMAGE_DIGEST)#' deploy/deployment.yaml; \
	 } > $(RELEASE_DIR)/charter-$(VERSION).yaml
	cp deploy/admission-policy.yaml $(RELEASE_DIR)/charter-$(VERSION)-admission-policy.yaml
	cp deploy/flux/resourceset.yaml $(RELEASE_DIR)/charter-$(VERSION)-flux-resourceset.yaml
	cd $(RELEASE_DIR) && sha256sum * > SHA256SUMS
	@echo "✓ release assets in $(RELEASE_DIR)/"

release-assets-test: ## Prove release-assets pins the image by digest, keeps every kind the install needs, and checksums every file
	@tmp=$$(mktemp -d); trap 'rm -rf "$$tmp"' EXIT; \
	  test -x dist/$(BINARY) || { echo "run make dist first"; exit 1; }; \
	  d=sha256:$$(printf '%064d' 0); \
	  $(MAKE) --no-print-directory -s release-assets VERSION=0.0.0-test IMAGE_DIGEST=$$d RELEASE_DIR=$$tmp/r >/dev/null; \
	  b=$$tmp/r/charter-0.0.0-test.yaml; \
	  grep -q "image: ghcr.io/firestoned/charter@$$d" $$b || { echo "image not pinned to the digest"; exit 1; }; \
	  ! grep -q 'REPLACE_WITH' $$b || { echo "placeholder digest left in the bundle"; exit 1; }; \
	  for k in CustomResourceDefinition ServiceAccount ClusterRole ClusterRoleBinding Deployment; do \
	    grep -q "^kind: $$k$$" $$b || { echo "bundle lacks $$k"; exit 1; }; done; \
	  ( cd $$tmp/r && sha256sum -c --quiet SHA256SUMS ) || { echo "checksums do not verify"; exit 1; }; \
	  n=$$(ls $$tmp/r | grep -vc SHA256SUMS); c=$$(wc -l < $$tmp/r/SHA256SUMS); \
	  [ "$$n" = "$$c" ] || { echo "SHA256SUMS covers $$c of $$n files"; exit 1; }; \
	  echo "release-assets-test: ok"

# ─── kind (no cloud credentials) ──────────────────────────────────────────────

kind-install: ## Install the pinned kind CLI into $(KIND_BIN_DIR) if missing or another version
	@if command -v kind >/dev/null 2>&1 && kind version | grep -q "v$(KIND_VERSION) "; then \
		echo "✓ kind v$(KIND_VERSION) present"; \
	else \
		echo "Installing kind v$(KIND_VERSION) into $(KIND_BIN_DIR)..."; \
		OS=$$(uname -s | tr '[:upper:]' '[:lower:]'); ARCH=$$(uname -m); \
		case "$$ARCH" in x86_64) ARCH=amd64 ;; aarch64|arm64) ARCH=arm64 ;; esac; \
		BIN="kind-$${OS}-$${ARCH}"; URL="https://github.com/kubernetes-sigs/kind/releases/download/v$(KIND_VERSION)"; \
		TMP=$$(mktemp -d); cd $$TMP && \
		curl -sSLf -o $$BIN "$$URL/$$BIN" && curl -sSLf -o $$BIN.sha256sum "$$URL/$$BIN.sha256sum" && \
		EXPECTED=$$(awk '{print $$1}' $$BIN.sha256sum) && \
		if command -v sha256sum >/dev/null 2>&1; then ACTUAL=$$(sha256sum $$BIN | awk '{print $$1}'); else ACTUAL=$$(shasum -a 256 $$BIN | awk '{print $$1}'); fi && \
		[ "$$EXPECTED" = "$$ACTUAL" ] || { echo "ERROR: kind checksum mismatch"; exit 1; }; \
		chmod +x $$BIN; \
		if [ -w "$(KIND_BIN_DIR)" ]; then mv $$BIN $(KIND_BIN_DIR)/kind; else sudo mv $$BIN $(KIND_BIN_DIR)/kind; fi; \
		rm -rf $$TMP; echo "✓ kind v$(KIND_VERSION) installed"; \
	fi
	@command -v kubectl >/dev/null 2>&1 || { echo "ERROR: kubectl not found on PATH"; exit 1; }

kind-create: kind-install ## Create the kind cluster (no-op if it exists) and write $(KIND_KUBECONFIG)
	@mkdir -p $(KIND_DIR)
	@if kind get clusters 2>/dev/null | grep -qx $(KIND_CLUSTER_NAME); then \
		echo "✓ kind cluster '$(KIND_CLUSTER_NAME)' already exists"; \
	else \
		kind create cluster --name $(KIND_CLUSTER_NAME) --image $(KIND_NODE_IMAGE) --wait 120s --kubeconfig $(KIND_KUBECONFIG); \
	fi
	@kind get kubeconfig --name $(KIND_CLUSTER_NAME) > $(KIND_KUBECONFIG)

kind-delete: ## Delete the kind cluster and its kubeconfig
	@if kind get clusters 2>/dev/null | grep -qx $(KIND_CLUSTER_NAME); then \
		kind delete cluster --name $(KIND_CLUSTER_NAME); \
	else \
		echo "✓ no kind cluster named '$(KIND_CLUSTER_NAME)'"; \
	fi
	@rm -rf $(KIND_DIR)

kind-image: kind-create dist ## The controller image over dist/ (BINARY_FROM=host), loaded into the cluster
	$(CONTAINER_TOOL) build --build-arg BINARY_FROM=host -t $(KIND_IMAGE) .
	@if [ "$(CONTAINER_TOOL)" = docker ]; then \
		kind load docker-image $(KIND_IMAGE) --name $(KIND_CLUSTER_NAME); \
	else \
		$(CONTAINER_TOOL) save --format docker-archive -o $(KIND_DIR)/image.tar $(KIND_IMAGE) && \
		kind load image-archive $(KIND_DIR)/image.tar --name $(KIND_CLUSTER_NAME); \
	fi

kind-e2e: kind-image ## CRD, admission policies and the controller image in kind (scripts/kind-e2e.sh)
	./scripts/kind-e2e.sh $(KIND_KUBECONFIG) $(KIND_IMAGE)

kind-e2e-ci: ## kind-e2e on a fresh cluster, torn down after; dumps state on failure
	@$(MAKE) --no-print-directory kind-e2e || { \
	  echo "::group::cluster state"; \
	  kubectl --kubeconfig $(KIND_KUBECONFIG) get iamclients,pods,events -A || true; \
	  kubectl --kubeconfig $(KIND_KUBECONFIG) -n charter-system logs deploy/charter-iam --all-containers || true; \
	  echo "::endgroup::"; $(MAKE) --no-print-directory kind-delete; exit 1; }
	@$(MAKE) --no-print-directory kind-delete

# ─── Docs ─────────────────────────────────────────────────────────────────────

docs: ## Build the documentation site into docs/site (strict)
	@command -v poetry >/dev/null 2>&1 || { echo "Poetry not found: https://python-poetry.org/docs/#installation"; exit 1; }
	cd docs && poetry install --no-interaction --quiet --no-root
	cd docs && poetry run mkdocs build

docs-serve: ## Serve the docs with live reload on http://127.0.0.1:8000
	@command -v poetry >/dev/null 2>&1 || { echo "Poetry not found: https://python-poetry.org/docs/#installation"; exit 1; }
	cd docs && poetry install --no-interaction --quiet --no-root
	cd docs && poetry run mkdocs serve --livereload

docs-clean: ## Remove docs build output and virtualenv
	rm -rf docs/site docs/.venv

clean: ## Remove build artefacts
	cargo clean
	rm -rf dist $(RELEASE_DIR) $(KIND_DIR) *.cdx.json
